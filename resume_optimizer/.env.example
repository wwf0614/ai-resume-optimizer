# 复制此文件为 .env 后按需修改
# ── AI 模型（小米 MiMo v2.5）──
OPENAI_API_KEY=你的_MiMo_API_Key
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5

# ── 智谱 GLM（超精细限定版专用，glm-4.7-flash 永久免费）──
GLM_API_KEY=你的_智谱_API_Key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.7-flash

# ── MySQL 数据库 ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=resume_app
DB_PASSWORD=你的_数据库密码
DB_NAME=resume_optimizer

# ── 管理员 ──
# 管理员后台访问密码（admin.html 提交时校验，或请求头 X-Admin-Password）
ADMIN_PASSWORD=请设置管理员密码

# ── 模板库 ──
# 最多允许的模板数量（含内置模板）
MAX_TEMPLATES=100
# 内置模板名称（首次启动自动注册）
BUILTIN_TEMPLATE_NAME=标准简洁模板

# ── 文件上传 ──
# 上传文件最大字节数（默认 10MB）
MAX_UPLOAD_SIZE=10485760

# ── OCR（扫描版 PDF / 图片简历识别，默认 Windows 安装路径）──
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
